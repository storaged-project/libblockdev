#!/bin/bash

# fake 'zkey list' output with a single key associated with multiple volumes (and
# multiple APQNs); the extra volumes are printed on continuation lines that -- unlike
# APQNs -- themselves contain a colon (the "volume:dmname" format), which the parser
# must not mistake for a new "label : value" line

cat <<EOF
Key                          : secure_xtskey1
---------------------------------------------------------------------
        Description          : This is our secure key in a repository
        Secure key size      : 272 bytes
        Clear key size       : 512 bits
        XTS type key         : Yes
        Key type             : CCA-AESCIPHER
        Volumes              : /dev/mapper/disk1:enc-disk1
                               /dev/mapper/disk2:enc-disk2
                               /dev/mapper/disk3:enc-disk3
        APQNs                : 03.0039
                               04.0039
        Key file name        : /etc/zkey/repository/secure_xtskey1.skey
        Sector size          : (system default)
        Volume type          : LUKS2
        Verification pattern : ac08c5d154374a247d6bbbae047ab9f8
                               541575915e764f6e35817b56bcf7c999
        KMS                  : (local)
        KMS key label        : (local)
        Dummy passphrase     : (none)
        Created              : 2020-08-20 16:57:32
        Changed              : (never)
        Re-enciphered        : (never)
EOF
